{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "PrintBridge": {
    "queueRootPath": "C:\\Hardness-Print-Brige\\print-agent",
    "watchPath": "C:\\Hardness-Print-Brige\\print-agent\\inbox",
    "processingPath": "C:\\Hardness-Print-Brige\\print-agent\\processing",
    "printedPath": "C:\\Hardness-Print-Brige\\print-agent\\printed",
    "errorPath": "C:\\Hardness-Print-Brige\\print-agent\\error",
    "printerName": "",
    "defaultPrinterName": "Microsoft Print to PDF",
    "pollIntervalMs": 10000,
    "remoteSourceEnabled": true,
    "remoteListUrl": "http://localhost/api/rel/get/list_files?API_AUTH=REPLACE_ME",
    "remoteDownloadUrlTemplate": "http://localhost/api/rel/get/select_file?API_AUTH=REPLACE_ME&file={fileName}",
    "remotePollIntervalMs": 10000,
    "remoteTimeoutMs": 10000,
    "remoteMaxFilesPerCycle": 20,
    "remoteAllowInsecureTls": true,
    "remoteSeenCachePath": "meta\\remote-seen.json",
    "logLevel": "Information",
    "hardnessCallbackUrl": "http://localhost/api/rel/get/callback?API_AUTH=REPLACE_ME",
    "apiAuthToken": ""
  },
  "App": {
    "installPath": "",
    "startWithWindows": true,
    "checkForUpdatesOnStartup": true,
    "updateCheckIntervalHours": 6,
    "minimizeToTrayOnClose": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}