{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/print-bridge-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "PrintBridge": {
    "WatchPath": "C:\\Hardness-Print-Brige\\print-agent\\inbox",
    "ProcessingPath": "C:\\Hardness-Print-Brige\\print-agent\\processing",
    "PrintedPath": "C:\\Hardness-Print-Brige\\print-agent\\printed",
    "ErrorPath": "C:\\Hardness-Print-Brige\\print-agent\\error",
    "PrinterName": "",
    "DefaultPrinterName": "Microsoft Print to PDF",
    "PollIntervalMs": 10000,
    "RemoteSourceEnabled": false,
    "RemoteListUrl": "http://localhost/api/rel/list_files?API_AUTH=REPLACE_ME",
    "RemoteDownloadUrlTemplate": "http://localhost/api/rel/select_file?API_AUTH=REPLACE_ME&file={fileName}",
    "RemotePollIntervalMs": 10000,
    "RemoteTimeoutMs": 10000,
    "RemoteMaxFilesPerCycle": 20,
    "RemoteAllowInsecureTls": false,
    "RemoteSeenCachePath": "meta\\remote-seen.json",
    "LogLevel": "Information",
    "HardnessCallbackUrl": "http://localhost/api/rel/callback?API_AUTH=REPLACE_ME"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
