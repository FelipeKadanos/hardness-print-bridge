{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/print-bridge-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "PrintBridge": {
    "WatchPath": "C:\\hardness\\print-agent\\inbox",
    "ProcessingPath": "C:\\hardness\\print-agent\\processing",
    "PrintedPath": "C:\\hardness\\print-agent\\printed",
    "ErrorPath": "C:\\hardness\\print-agent\\error",
    "PrinterName": "",
    "DefaultPrinterName": "Default Printer",
    "PollIntervalMs": 2000,
    "LogLevel": "Information",
    "HardnessCallbackUrl": "http://localhost:8080/api/print/callback",
    "HardnessCallbackToken": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
